# ==============================================================================
# Git Ignore Configuration - MVS 3D Reconstruction & Evaluation Benchmark
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# IDEs and Code Editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Extracted scene data & runtime outputs (populated from data/bundles/*_bundle.zip)
data/scenes/*
!data/scenes/.gitkeep
data/outputs/*
!data/outputs/.gitkeep
data/colab_inputs/
data/outputs/temp_*.zip
/*_bundle.zip
/Ignatius.zip
/Truck.zip
/Barn.zip
/Ignatius.ply
/Truck.ply
/Barn.ply

# Testing, Coverage & Build artifacts
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# Logs & Temporary Files
*.log
.cache/
tmp/
temp/
